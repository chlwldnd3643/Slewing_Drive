// === Handle Arduino (Nano): AS5600 + Steering send + FFT spectrum ===
#include <Wire.h>
#include <AS5600.h>
#include <SoftwareSerial.h>
#include <arduinoFFT.h>

AS5600 magneticEncoder;

// ===== UART (Handle -> Slewing) =====
const uint8_t HANDLE_TX_PIN = 8;   // TX on D8 (to other board RX)
const uint8_t HANDLE_RX_PIN = 9;   // dummy RX
SoftwareSerial linkSerial(HANDLE_RX_PIN, HANDLE_TX_PIN); // (RX, TX)

// ===== AS5600 / Handle range settings =====
const int   TICKS_PER_REV       = 4096;     // AS5600: 0..4095
const int   WRAP_THRESHOLD      = 2048;     // half-turn threshold
const long  MAX_TURNS_EACH_SIDE = 2;        // ±2 turns valid
const long  MAX_TICKS           = TICKS_PER_REV * MAX_TURNS_EACH_SIDE;

const float SAFE_RATIO          = 0.9f;
const long  SAFE_TICKS          = (long)(MAX_TICKS * SAFE_RATIO);

// ===== State =====
long     turnCount   = 0;
uint16_t prevRaw     = 0;
long     zeroAbsTick = 0;

// ===== TX rate (control output) =====
static const uint16_t TX_RATE_HZ = 50;
static const unsigned long TX_PERIOD_MS = 1000UL / TX_RATE_HZ;
unsigned long lastTxMs = 0;

// ===== Debug print rate =====
static const unsigned long DBG_PERIOD_MS = 200;
unsigned long lastDbgMs = 0;

// ===== FFT settings =====
static const uint16_t FFT_N = 128;       // 64/128 recommended on Nano
static const float    FFT_FS = 250.0f;   // sampling rate for FFT (Hz)

const unsigned long FFT_SAMPLE_US = (unsigned long)(1000000.0f / FFT_FS);
unsigned long lastFftSampleUs = 0;

double vReal[FFT_N];
double vImag[FFT_N];
uint16_t fftIndex = 0;

arduinoFFT FFT;

// 출력 과부하 방지: FFT 윈도우 몇 번 중 1번 출력
static const uint8_t FFT_PRINT_EVERY_WINDOWS = 4; // ~ (FFT_N/FFT_FS)*4 ≈ 2.0s
uint8_t fftWindowCount = 0;

// ===== Choose FFT input =====
// 0: cmd (-1000..1000)   [추천]
// 1: norm (-1..1)
// 2: raw (0..4095)
static const uint8_t FFT_INPUT_MODE = 0;

static inline double getFftSample(float norm, int16_t cmd, uint16_t raw) {
  if (FFT_INPUT_MODE == 2) return (double)raw;
  if (FFT_INPUT_MODE == 1) return (double)norm;
  return (double)cmd;
}

static void printSpectrumCSV() {
  Serial.println(F("FFT_BEGIN"));
  // DC(0) 제외, 1..N/2-1 출력
  for (uint16_t i = 1; i < (FFT_N / 2); i++) {
    double freq = (i * FFT_FS) / FFT_N;
    double mag  = vReal[i];
    Serial.print(freq, 3);
    Serial.print(',');
    Serial.println(mag, 6);
  }
  Serial.println(F("FFT_END"));
}

// ===== Init: power-on position becomes center =====
void init_encoder_center() {
  magneticEncoder.begin(4);
  magneticEncoder.setDirection(AS5600_CLOCK_WISE);

  int connected = magneticEncoder.isConnected();
  Serial.print(F("AS5600 Connect: "));
  Serial.println(connected);

  // average few reads for stable boot
  uint32_t sum = 0;
  const int N = 10;
  for (int i = 0; i < N; i++) {
    sum += magneticEncoder.rawAngle();
    delay(5);
  }
  uint16_t raw0 = (uint16_t)(sum / N);

  turnCount   = 0;
  prevRaw     = raw0;
  zeroAbsTick = (long)raw0;

  Serial.print(F("Init raw0 = "));
  Serial.println(raw0);
  Serial.println(F("Power-on steering position set as CENTER (0)."));
}

// ===== Return -1.0..+1.0 with ±90% range clamp =====
float get_handle_normalized_from_raw(uint16_t raw) {
  int diff = (int)raw - (int)prevRaw;

  // wrap detection
  if (diff > WRAP_THRESHOLD) {
    turnCount--;
  } else if (diff < -WRAP_THRESHOLD) {
    turnCount++;
  }
  prevRaw = raw;

  long absTick = turnCount * (long)TICKS_PER_REV + raw;
  long relTick = absTick - zeroAbsTick;

  // clamp to physical ±MAX_TICKS
  if (relTick >  MAX_TICKS) relTick =  MAX_TICKS;
  if (relTick < -MAX_TICKS) relTick = -MAX_TICKS;

  // clamp to control safe ±SAFE_TICKS
  if (relTick >  SAFE_TICKS) relTick =  SAFE_TICKS;
  if (relTick < -SAFE_TICKS) relTick = -SAFE_TICKS;

  return (float)relTick / (float)SAFE_TICKS;
}

void setup() {
  Serial.begin(115200);
  while (!Serial) {}

  Wire.begin();
  Wire.setClock(400000UL);      // I2C 400kHz (권장)

  linkSerial.begin(57600);

  init_encoder_center();

  Serial.println(F("Handle Arduino READY."));
  Serial.print(F("TX_RATE_HZ=")); Serial.println(TX_RATE_HZ);
  Serial.print(F("FFT_FS="));     Serial.println(FFT_FS);
  Serial.print(F("FFT_N="));      Serial.println(FFT_N);
  Serial.println(F("FFT output format: FFT_BEGIN / freq,mag / FFT_END"));
}

void loop() {
  // 항상 최신 raw 읽기 (여기서 1회만 읽고 재사용)
  uint16_t raw = magneticEncoder.rawAngle();
  float norm = get_handle_normalized_from_raw(raw);

  int16_t cmd = (int16_t)(norm * 1000.0f);
  if (cmd >  1000) cmd =  1000;
  if (cmd < -1000) cmd = -1000;

  // ===== 1) Control TX at 50Hz =====
  unsigned long nowMs = millis();
  if (nowMs - lastTxMs >= TX_PERIOD_MS) {
    lastTxMs += TX_PERIOD_MS;

    // protocol: S<cmd>\n
    linkSerial.print('S');
    linkSerial.println(cmd);
  }

  // ===== 2) FFT sampling at FFT_FS =====
  unsigned long nowUs = micros();
  if (nowUs - lastFftSampleUs >= FFT_SAMPLE_US) {
    lastFftSampleUs += FFT_SAMPLE_US;

    vReal[fftIndex] = getFftSample(norm, cmd, raw);
    vImag[fftIndex] = 0.0;
    fftIndex++;

    if (fftIndex >= FFT_N) {
      fftIndex = 0;

      FFT.Windowing(vReal, FFT_N, FFT_WIN_TYP_HAMMING, FFT_FORWARD);
      FFT.Compute(vReal, vImag, FFT_N, FFT_FORWARD);
      FFT.ComplexToMagnitude(vReal, vImag, FFT_N);

      fftWindowCount++;
      if ((fftWindowCount % FFT_PRINT_EVERY_WINDOWS) == 0) {
        printSpectrumCSV();
      }
    }
  }

  // ===== 3) Debug print (rate-limited) =====
  if (nowMs - lastDbgMs >= DBG_PERIOD_MS) {
    lastDbgMs += DBG_PERIOD_MS;

    // angle in degrees (AS5600_RAW_TO_DEGREES is defined by AS5600 lib)
    float angle = raw * AS5600_RAW_TO_DEGREES;

    Serial.print(F("raw="));
    Serial.print(raw);
    Serial.print(F(" angle="));
    Serial.print(angle, 2);
    Serial.print(F(" norm="));
    Serial.print(norm, 3);
    Serial.print(F(" cmd="));
    Serial.println(cmd);
  }
}
