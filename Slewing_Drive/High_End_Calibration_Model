import time
import threading
import queue
import random
from typing import Optional, Tuple

import numpy as np
import serial

# ==========================
# FIXED SETTINGS
# ==========================
PORT = "COM3"
UNO_BAUD = 115200
READ_TIMEOUT = 0.2

CMD_EN = "en"
CMD_SPD_1000 = "spd 1000"

INC_PER_DEG = (182.0 * 70.0 * 150.0) / 62.0
ECC_PERIOD = INC_PER_DEG * (360.0 / 62.0)
MESH_PERIOD = ECC_PERIOD / 150.0

# ==========================
# 핵심 동작 모드
# ==========================
# True:
#   - abs 90 입력 시, "예측 도달 위치"를 그대로 abs로 전송
#   - 보정 OFF => raw_pred로 이동
#   - 보정 ON  => comp_pred로 이동
#
# False:
#   - 보정 OFF => target 그대로 전송
#   - 보정 ON  => comp_cmd 전송 (정석 보정: 목표 90에 가게 하는 방식)
MOVE_TO_PREDICTED = True


# ==========================
# 0. 하드웨어 물리적 오차 시뮬레이터
# ==========================
class InternalErrorInjector:
    """
    E1: 통합 선형 오차 y = a*x + b
        - 90deg 기준 오차율 15~25% 되도록 a를 설정
        - b=0 고정 => 90deg 오차율이 항상 15~25% 범위
    """
    def __init__(self):
        self.e1_on = False
        self.e3_on = False
        self.e4_on = False
        self.e5_on = False
        self.e6_on = False

        # E1(ax+b)
        self._a_err = 1.0
        self._b_err = 0.0

        # E3~E5
        self._ecc_amp = 0.0
        self._mesh_amp = 0.0
        self._backlash = 0.0

        # E6
        self._e6_cw_ratio = 0.0
        self._e6_ccw_ratio = 0.0
        self._accumulated_e6_err = 0.0

        self.prev_cmd = 0.0
        self.current_dir = 1

    def toggle_e1(self):
        self.e1_on = not self.e1_on
        if self.e1_on:
            rate = random.uniform(0.15, 0.25)
            sign = random.choice([-1.0, 1.0])
            self._a_err = 1.0 + sign * rate
            self._b_err = 0.0
        else:
            self._a_err = 1.0
            self._b_err = 0.0
        return self.e1_on

    def toggle_e3(self):
        self.e3_on = not self.e3_on
        if self.e3_on:
            self._ecc_amp = INC_PER_DEG * random.uniform(0.1, 0.3)
        return self.e3_on

    def toggle_e4(self):
        self.e4_on = not self.e4_on
        if self.e4_on:
            self._mesh_amp = INC_PER_DEG * random.uniform(0.02, 0.05)
        return self.e4_on

    def toggle_e5(self):
        self.e5_on = not self.e5_on
        if self.e5_on:
            self._backlash = INC_PER_DEG * random.uniform(0.2, 0.5)
        return self.e5_on

    def toggle_e6(self):
        self.e6_on = not self.e6_on
        if self.e6_on:
            self._e6_cw_ratio = random.choice([-1.0, 1.0]) * random.uniform(0.20, 0.30)
            self._e6_ccw_ratio = random.choice([-1.0, 1.0]) * random.uniform(0.20, 0.30)
            self._accumulated_e6_err = 0.0
        else:
            self._accumulated_e6_err = 0.0
        return self.e6_on

    def apply(self, cmd_val: float, update_state: bool = True) -> float:
        delta = cmd_val - self.prev_cmd
        direction = 1 if delta >= 0 else -1

        err = 0.0

        # E1: y = a*x + b  => err = (a*x + b) - x
        if self.e1_on:
            err += (self._a_err * cmd_val + self._b_err) - cmd_val

        if self.e3_on:
            err += self._ecc_amp * np.sin(2.0 * np.pi * cmd_val / ECC_PERIOD)

        if self.e4_on:
            err += self._mesh_amp * np.sin(2.0 * np.pi * cmd_val / MESH_PERIOD)

        if self.e5_on:
            err += (self._backlash / 2.0) if direction >= 0 else -(self._backlash / 2.0)

        # E6 누적 슬립
        e6_step_err = 0.0
        if self.e6_on:
            if delta >= 0:
                e6_step_err = delta * self._e6_cw_ratio
            else:
                e6_step_err = delta * self._e6_ccw_ratio

            if update_state:
                self._accumulated_e6_err += e6_step_err

            err += (self._accumulated_e6_err if update_state else (self._accumulated_e6_err + e6_step_err))

        if update_state:
            self.prev_cmd = cmd_val
            self.current_dir = direction

        return cmd_val + err


# ==========================
# 1. 자가 학습 보정 제어기
# ==========================
class CalibrationFilter:
    def __init__(self):
        self.r1_on = False  # b
        self.r2_on = False  # a
        self.r3_on = False
        self.r4_on = False
        self.r5_on = False
        self.r6_on = False
        self.r7_on = False

        self.k_est = 0.0     # b 추정
        self.m_est = 1.0     # a 추정

        self.ecc_A_est = 0.0
        self.ecc_B_est = 0.0
        self.mesh_A_est = 0.0
        self.mesh_B_est = 0.0
        self.backlash_est = 0.0

        self.e6_cw_ratio_est = 0.0
        self.e6_ccw_ratio_est = 0.0

        self.prev_target = 0.0
        self.prev_r7_cmd = 0.0

    def any_comp_on(self) -> bool:
        return any([self.r1_on, self.r2_on, self.r3_on, self.r4_on, self.r5_on, self.r6_on, self.r7_on])

    def system_identification(self, targets_cw, actuals_cw, targets_ccw, actuals_ccw):
        N = len(targets_cw)
        actuals_ccw_aligned = actuals_ccw[::-1]
        diff = actuals_cw - actuals_ccw_aligned
        self.backlash_est = np.mean(diff)

        actuals_mid = (actuals_cw + actuals_ccw_aligned) / 2.0
        coeffs = np.polyfit(targets_cw, actuals_mid, 1)
        self.m_est = float(coeffs[0])
        self.k_est = float(coeffs[1])

        residuals = actuals_mid - (self.m_est * targets_cw + self.k_est)

        self.ecc_A_est = np.sum(residuals * np.sin(2.0 * np.pi * targets_cw / ECC_PERIOD)) * (2.0 / N)
        self.ecc_B_est = np.sum(residuals * np.cos(2.0 * np.pi * targets_cw / ECC_PERIOD)) * (2.0 / N)

        res_e4 = residuals - (
            self.ecc_A_est * np.sin(2.0 * np.pi * targets_cw / ECC_PERIOD) +
            self.ecc_B_est * np.cos(2.0 * np.pi * targets_cw / ECC_PERIOD)
        )

        self.mesh_A_est = np.sum(res_e4 * np.sin(2.0 * np.pi * targets_cw / MESH_PERIOD)) * (2.0 / N)
        self.mesh_B_est = np.sum(res_e4 * np.cos(2.0 * np.pi * targets_cw / MESH_PERIOD)) * (2.0 / N)

    def pre_compensate(self, target: float) -> float:
        delta_target = target - self.prev_target
        direction = 1 if delta_target >= 0 else -1

        delta_cmd = delta_target

        # E6 보정
        if self.r7_on:
            if delta_target >= 0:
                delta_cmd = delta_target / (1.0 + self.e6_cw_ratio_est)
            else:
                delta_cmd = delta_target / (1.0 + self.e6_ccw_ratio_est)
            base_cmd = self.prev_r7_cmd + delta_cmd
        elif self.r6_on:
            if delta_target >= 0:
                delta_cmd = delta_target - (delta_target * self.e6_cw_ratio_est)
            else:
                delta_cmd = delta_target - (delta_target * self.e6_ccw_ratio_est)
            base_cmd = self.prev_r7_cmd + delta_cmd
        else:
            base_cmd = target

        cmd = base_cmd

        if self.r5_on:
            cmd -= (self.backlash_est / 2.0) * direction

        if self.r4_on:
            cmd -= (
                self.mesh_A_est * np.sin(2.0 * np.pi * target / MESH_PERIOD) +
                self.mesh_B_est * np.cos(2.0 * np.pi * target / MESH_PERIOD)
            )

        if self.r3_on:
            cmd -= (
                self.ecc_A_est * np.sin(2.0 * np.pi * target / ECC_PERIOD) +
                self.ecc_B_est * np.cos(2.0 * np.pi * target / ECC_PERIOD)
            )

        # 선형 보정: cmd = (target - b)/a
        if self.r1_on:
            cmd -= self.k_est
        if self.r2_on:
            cmd /= self.m_est

        self.prev_target = target
        self.prev_r7_cmd = base_cmd
        return cmd

    def evaluate(self, target: float, raw_pred: float, comp_pred: float) -> Tuple[float, float, float, float, float]:
        err_pre = abs(raw_pred - target)
        err_post = abs(comp_pred - target)

        imp = 0.0
        if err_pre > 2.0:
            imp = (1.0 - (err_post / err_pre)) * 100.0
        elif err_pre <= 2.0 and err_post <= 2.0:
            imp = 100.0

        err_rate_pre = (err_pre / abs(target)) * 100.0 if abs(target) > 0.001 else 0.0
        err_rate_post = (err_post / abs(target)) * 100.0 if abs(target) > 0.001 else 0.0

        return err_pre, err_post, imp, err_rate_pre, err_rate_post


