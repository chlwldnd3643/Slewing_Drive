# 3. 메인 인터페이스 (CLI)
# ==========================
def print_help_menu():
    print("\n======= COMMANDS =======")
    print("  en            -> 모터 활성화")
    print("  unit          -> 입력 모드 토글 (현재 기본값: 각도 Degree)")
    print("  abs <val>     -> 절대 위치 이동")
    print("  --- 5대 기계 결함 주입 (Error Injectors) ---")
    print("  e1 : 영점 오프셋   e2 : 스케일 오차    e3 : 기어 편심")
    print("  e4 : 치합 오차     e5 : 방향성 백래시")
    print("  --- 5대 전담 보정기 (Compensators) ---")
    print("  cal           -> ★필수★ [System ID] 10만 포인트 스캔으로 오차 학습!")
    print("  r1 : 오프셋 보정   r2 : 스케일 보정    r3 : 편심 노이즈 캔슬링")
    print("  r4 : 치합 캔슬링   r5 : 백래시 보상")
    print("  --- 모니터링 ---")
    print("  p             -> [PDO 피드백] 실시간 모니터링 ON/OFF")
    print("  q             -> 프로그램 종료")
    print("========================\n")


def interactive_main():
    print(f"[{PORT}] System ID 완전 구현! 5:5 듀얼 제어 시뮬레이터 시작...")
    cli = ArduinoClient(port=PORT, baud=UNO_BAUD, timeout=READ_TIMEOUT)
    try:
        cli.open()
    except Exception as e:
        print(f"포트 연결 실패: {e}\n하드웨어 연결을 확인하세요.")
        return

    input_unit = "deg"
    print_help_menu()

    try:
        while True:
            cmd = input(f"({input_unit})> ").strip().lower()
            if not cmd: continue

            if cmd in ("q", "quit", "exit"):
                break
            elif cmd in ("h", "help", "?"):
                print_help_menu()

            elif cmd == "unit":
                if input_unit == "inc":
                    input_unit = "deg"
                    print(f"[설정] 각도(Degree) 모드 (1도 = {INC_PER_DEG:.4f} inc)")
                else:
                    input_unit = "inc"
                    print("[설정] 인크리먼트(Increment) 모드")

            elif cmd.startswith("abs ") or cmd.startswith("rel "):
                parts = cmd.split()
                if len(parts) >= 2:
                    try:
                        cmd_type = parts[0]
                        user_val = float(parts[1])

                        target_val = user_val * INC_PER_DEG if input_unit == "deg" else user_val

                        # 평가판용 유령 스캔 (모터 방향성 유지)
                        raw_actual = cli.inj.apply(target_val, update_state=False)

                        comp_cmd = cli.cal.pre_compensate(target_val)
                        actual_val = cli.inj.apply(comp_cmd, update_state=True)

                        ep, ea, imp, err_rate = cli.cal.evaluate(target_val, raw_actual, actual_val)

                        final_cmd = f"{cmd_type} {int(comp_cmd)}"
                        cli.send(final_cmd)

                        print(f"\n[SDO 지령 전송] {cmd_type.upper()} 제어")
                        print(f" - 타겟(Target): {target_val:.1f} inc")
                        print(f" - 사전왜곡 지령: {comp_cmd:.1f} inc")
                        print(f" - 도달 위치    : {actual_val:.1f} inc (보정 잔류오차: {ea:.1f})")
                        rate_str = f"{err_rate:.4f}%" if abs(target_val) > 0.001 else "N/A"
                        print(f" -> 물리적 송신 : '{final_cmd}' | %Err: {rate_str} | 개선율: {imp:.1f}%\n")

                        cli.read_status_burst(seconds=0.6)
                    except ValueError:
                        print("올바른 숫자를 입력하세요.")

            elif cmd == "cal":
                print("\n[System ID] 실제 모터를 -360도 ~ +360도로 정/역회전하며 데이터를 수집합니다...")

                # [BUG FIX] 5000개 -> 100,000개로 대폭 늘려 고주파(e4) 진동까지 나이퀴스트 스캔!
                targets_cw = np.linspace(-360 * INC_PER_DEG, 360 * INC_PER_DEG, 100000)
                actuals_cw = np.array([cli.inj.apply(t, update_state=True) for t in targets_cw])

                targets_ccw = np.linspace(360 * INC_PER_DEG, -360 * INC_PER_DEG, 100000)
                actuals_ccw = np.array([cli.inj.apply(t, update_state=True) for t in targets_ccw])

                print("[분석 중] 수집된 200,000개 초고해상도 데이터로 푸리에(FFT) 분석 진행 중...")

                cli.cal.system_identification(targets_cw, actuals_cw, targets_ccw, actuals_ccw)

                print("\n[캘리브레이션 완료] 제어기의 블라인드 추정 결과:")
                print(
                    f" - E1 (Offset)   : 추정값 {cli.cal.k_est:8.1f} | 정답 {cli.inj._k_err if cli.inj.e1_on else 0.0:8.1f}")
                print(
                    f" - E2 (Scale)    : 추정값 {cli.cal.m_est:8.5f} | 정답 {1.0 + cli.inj._m_err if cli.inj.e2_on else 1.0:8.5f}")

                ecc_amp_est = np.sqrt(cli.cal.ecc_A_est ** 2 + cli.cal.ecc_B_est ** 2)
                mesh_amp_est = np.sqrt(cli.cal.mesh_A_est ** 2 + cli.cal.mesh_B_est ** 2)

                print(
                    f" - E3 (Ecc Amp)  : 추정값 {ecc_amp_est:8.1f} | 정답 {cli.inj._ecc_amp if cli.inj.e3_on else 0.0:8.1f}")
                print(
                    f" - E4 (Mesh Amp) : 추정값 {mesh_amp_est:8.1f} | 정답 {cli.inj._mesh_amp if cli.inj.e4_on else 0.0:8.1f}")
                print(
                    f" - E5 (Backlash) : 추정값 {cli.cal.backlash_est:8.1f} | 정답 {cli.inj._backlash if cli.inj.e5_on else 0.0:8.1f}\n")

            elif cmd == "en":
                cli._drain_queue()
                cli.send(CMD_EN)
                time.sleep(0.05)
                cli.send(CMD_SPD_1000)
                print("Sent: en + spd 1000. Status:")
                cli.read_status_burst(seconds=1.2)

            # --- E 토글 ---
            elif cmd == "e1":
                print(f"[E1] 오프셋 오차 -> {'ON' if cli.inj.toggle_e1() else 'OFF'}")
            elif cmd == "e2":
                print(f"[E2] 스케일 오차 -> {'ON' if cli.inj.toggle_e2() else 'OFF'}")
            elif cmd == "e3":
                print(f"[E3] 편심 오차 -> {'ON' if cli.inj.toggle_e3() else 'OFF'}")
            elif cmd == "e4":
                print(f"[E4] 치합 오차 -> {'ON' if cli.inj.toggle_e4() else 'OFF'}")
            elif cmd == "e5":
                print(f"[E5] 백래시 유격 -> {'ON' if cli.inj.toggle_e5() else 'OFF'}")

                # --- R 토글 ---
            elif cmd == "r1":
                cli.cal.r1_on = not cli.cal.r1_on
                print(f"[R1] 데이터 기반 오프셋 보상기 -> {'ON' if cli.cal.r1_on else 'OFF'}")

            elif cmd == "r2":
                cli.cal.r2_on = not cli.cal.r2_on
                print(f"[R2] 데이터 기반 스케일 보상기 -> {'ON' if cli.cal.r2_on else 'OFF'}")

            elif cmd == "r3":
                cli.cal.r3_on = not cli.cal.r3_on
                print(f"[R3] 편심 노이즈 캔슬링 -> {'ON' if cli.cal.r3_on else 'OFF'}")

            elif cmd == "r4":
                cli.cal.r4_on = not cli.cal.r4_on
                print(f"[R4] 치합 노이즈 캔슬링 -> {'ON' if cli.cal.r4_on else 'OFF'}")

            elif cmd == "r5":
                cli.cal.r5_on = not cli.cal.r5_on
                print(f"[R5] 백래시 역보상 -> {'ON' if cli.cal.r5_on else 'OFF'}")

            elif cmd == "p":
                if cli._log_enabled:
                    cli.stop_logging()
                    print("[INFO] PDO 모니터링 OFF")
                else:
                    cli._drain_queue()
                    cli.start_logging()
                    print("[INFO] PDO 모니터링 ON")

            else:
                cli.send(cmd)
                print("Sent. Status:")
                cli.read_status_burst(seconds=0.6)

    finally:
        cli.stop_logging()
        cli.close()
        print("시스템 종료.")


if __name__ == "__main__":
    interactive_main()
