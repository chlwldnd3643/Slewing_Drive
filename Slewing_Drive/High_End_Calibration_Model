# 2. 시리얼 클라이언트 & 출력 필터링
# ==========================
def is_garbage_line(line: str) -> bool:
    garbage_keywords = ["=== Kinco", "cmd: en, rst", "Capture:", "[FILT]", "EMA1", "EMA2", "ema fc", "ema a"]
    return any(kw in line for kw in garbage_keywords)


class ArduinoClient:
    def __init__(self, port: str, baud: int = UNO_BAUD, timeout: float = READ_TIMEOUT):
        self.port = port
        self.baud = baud
        self.timeout = timeout
        self.ser = None

        self._rx_thread = None
        self._stop_evt = threading.Event()
        self._lines = queue.Queue(maxsize=8000)

        self._log_thread = None
        self._log_stop_evt = threading.Event()
        self._log_enabled = False

        self.status_unit = "deg"

        self.cal = CalibrationFilter()
        self.inj = InternalErrorInjector()

    def open(self):
        self.ser = serial.Serial(self.port, self.baud, timeout=self.timeout)
        time.sleep(1.5)
        self._stop_evt.clear()
        self._rx_thread = threading.Thread(target=self._rx_loop, daemon=True)
        self._rx_thread.start()

    def close(self):
        self.shutdown_logging()
        self._stop_evt.set()
        if self._rx_thread:
            self._rx_thread.join(timeout=1.0)
        if self.ser and self.ser.is_open:
            self.ser.close()

    def send(self, cmd: str):
        if not self.ser or not self.ser.is_open:
            return
        self.ser.write((cmd.strip() + "\n").encode("utf-8", errors="ignore"))
        self.ser.flush()

    def _rx_loop(self):
        buf = b""
        while not self._stop_evt.is_set():
            try:
                chunk = self.ser.read(512)
            except Exception:
                break
            if not chunk:
                continue
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                text = line.replace(b"\r", b"").decode("utf-8", errors="replace").strip()
                if text:
                    try:
                        self._lines.put_nowait(text)
                    except queue.Full:
                        pass

    def read_line(self, timeout_s: float = 0.5) -> Optional[str]:
        try:
            return self._lines.get(timeout=timeout_s)
        except queue.Empty:
            return None

    @staticmethod
    def parse_dual_value(line: str) -> Optional[Tuple[float, float]]:
        if "," in line:
            try:
                parts = line.split(",")
                return float(parts[0]), float(parts[1])
            except ValueError:
                return None
        return None

    def read_status_burst(self, seconds: float = 1.0):
        t0 = time.perf_counter()
        while time.perf_counter() - t0 < seconds:
            line = self.read_line(timeout_s=0.05)
            if not line:
                continue
            if is_garbage_line(line):
                continue
            if self.parse_dual_value(line.strip()) is None:
                print(line.strip())

    def _drain_queue(self):
        try:
            while True:
                self._lines.get_nowait()
        except queue.Empty:
            pass

    def start_logging(self):
        self._log_enabled = True
        if self._log_thread and self._log_thread.is_alive():
            return
        self._log_stop_evt.clear()

        def _printer():
            last_printed_unit = None
            while not self._log_stop_evt.is_set():
                if not self._log_enabled:
                    time.sleep(0.05)
                    continue

                if last_printed_unit != self.status_unit:
                    last_printed_unit = self.status_unit
                    u_str = "Deg" if self.status_unit == "deg" else "Inc"
                    print(
                        f"\n{'Target':>12} | {'RawPred':>14} | {'CompCmd':>14} | {'CompPred':>14} | "
                        f"{f'원래오차({u_str})':>13} | {f'남은오차({u_str})':>13} | {'원래%Err':>8} | {'남은%Err':>8} | {'Imp%':>6} | {'E/R'}"
                    )
                    print("-" * 140)

                line = self.read_line(timeout_s=0.2)
                if not line or is_garbage_line(line):
                    continue

                dual = self.parse_dual_value(line)
                if not dual:
                    continue

                _, n_raw = dual
                target = n_raw

                raw_pred = self.inj.apply(target, update_state=False)
                comp_cmd = self.cal.pre_compensate(target)
                comp_pred = self.inj.apply(comp_cmd, update_state=False)

                ep, ea, imp, err_rate_pre, err_rate_post = self.cal.evaluate(target, raw_pred, comp_pred)

                div = INC_PER_DEG if self.status_unit == "deg" else 1.0
                fmt = "12.3f" if self.status_unit == "deg" else "12.1f"

                e_flags = [self.inj.e1_on, self.inj.e3_on, self.inj.e4_on, self.inj.e5_on, self.inj.e6_on]
                e_labels = ["1", "3", "4", "5", "6"]
                e_str = "".join([lab if on else "-" for lab, on in zip(e_labels, e_flags)])

                r_flags = [self.cal.r1_on, self.cal.r2_on, self.cal.r3_on, self.cal.r4_on, self.cal.r5_on, self.cal.r6_on, self.cal.r7_on]
                r_labels = ["1", "2", "3", "4", "5", "6", "7"]
                r_str = "".join([lab if on else "-" for lab, on in zip(r_labels, r_flags)])

                print(
                    f"{(target/div):{fmt}} | {(raw_pred/div):14.3f} | {(comp_cmd/div):14.3f} | {(comp_pred/div):14.3f} | "
                    f"{(ep/div):13.3f} | {(ea/div):13.3f} | {err_rate_pre:7.3f}% | {err_rate_post:7.3f}% | {imp:6.1f}% | [{e_str}/{r_str}]"
                )

        self._log_thread = threading.Thread(target=_printer, daemon=True)
        self._log_thread.start()

    def stop_logging(self):
        self._log_enabled = False

    def shutdown_logging(self):
        self._log_stop_evt.set()
        if self._log_thread:
            self._log_thread.join(timeout=1.0)
            self._log_thread = None
        self._log_enabled = False


