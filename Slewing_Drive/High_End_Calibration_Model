def print_help_menu():
    print("\n======= COMMANDS =======")
    print("  abs <val>     -> 절대 위치 이동")
    print("  unit          -> [입력] 단위 변경 (deg/inc)")
    print("  status_unit   -> [출력] 단위 변경 (deg/inc)")
    print("  --- Errors ---")
    print("  e1            -> 선형 오차 y=ax+b (90deg 기준 15~25%)")
    print("  e3/e4/e5/e6   -> 기타 오차")
    print("  --- Cal/Comp ---")
    print("  cal           -> 선형/파동/백래시 스캔")
    print("  cal2          -> e6 ratio 추론")
    print("  r1~r7         -> 보정 토글")
    print("  p             -> 모니터링 ON/OFF")
    print("  en            -> enable + spd 1000")
    print("  q             -> 종료")
    print("========================\n")


def interactive_main():
    print(f"[{PORT}] '예측값으로 실제 이동' 모드 시작 (MOVE_TO_PREDICTED={MOVE_TO_PREDICTED})")
    cli = ArduinoClient(port=PORT, baud=UNO_BAUD, timeout=READ_TIMEOUT)
    try:
        cli.open()
    except Exception as e:
        print(f"포트 연결 실패: {e}\n하드웨어 연결을 확인하세요.")
        return

    input_unit = "deg"
    print_help_menu()

    try:
        while True:
            cmd = input(f"({input_unit})> ").strip().lower()
            if not cmd:
                continue

            if cmd in ("q", "quit", "exit"):
                break

            elif cmd in ("h", "help", "?"):
                print_help_menu()

            elif cmd == "unit":
                input_unit = "inc" if input_unit == "deg" else "deg"
                print(f"[설정] 입력 단위: {input_unit}")

            elif cmd == "status_unit":
                cli.status_unit = "inc" if cli.status_unit == "deg" else "deg"
                print(f"[설정] 출력 단위: {cli.status_unit}")

            elif cmd.startswith("abs "):
                parts = cmd.split()
                if len(parts) < 2:
                    continue

                user_val = float(parts[1])
                target_val = user_val * INC_PER_DEG if input_unit == "deg" else user_val

                # 1) 예측 계산 (상태 변경 없이)
                raw_pred = cli.inj.apply(target_val, update_state=False)
                comp_cmd = cli.cal.pre_compensate(target_val)
                comp_pred = cli.inj.apply(comp_cmd, update_state=False)

                # 2) "이번에 실제로 가게 할 값" 결정
                if MOVE_TO_PREDICTED:
                    # 보정 ON이면 comp_pred로, OFF면 raw_pred로 "실제 이동"
                    desired_move = comp_pred if cli.cal.any_comp_on() else raw_pred
                    send_pos = int(round(desired_move))
                else:
                    # 정석: 보정 ON이면 comp_cmd, OFF면 target 그대로
                    send_pos = int(round(comp_cmd)) if cli.cal.any_comp_on() else int(round(target_val))

                final_cmd = f"abs {send_pos}"
                cli.send(final_cmd)

                # 3) 시뮬 상태도 "그 명령을 보냈다"로 업데이트(로그/다음 스텝 일관성)
                _ = cli.inj.apply(float(send_pos), update_state=True)

                div = INC_PER_DEG if cli.status_unit == "deg" else 1.0
                u_str = "deg" if cli.status_unit == "deg" else "inc"

                print("\n[ABS 명령]")
                print(f" - 입력 목표(target)     : {target_val/div:.3f} {u_str}")
                print(f" - Raw 예측(raw_pred)    : {raw_pred/div:.3f} {u_str}")
                print(f" - CompCmd(보정명령)     : {comp_cmd/div:.3f} {u_str}")
                print(f" - Comp 예측(comp_pred)  : {comp_pred/div:.3f} {u_str}")
                print(f" - 실제 전송(abs)        : {send_pos/div:.3f} {u_str}  (cmd: '{final_cmd}')\n")

                cli.read_status_burst(seconds=0.6)

            elif cmd == "cal":
                print("\n[cal] 오차 스캔...")
                targets_cw = np.linspace(-360 * INC_PER_DEG, 360 * INC_PER_DEG, 100000)
                actuals_cw = np.array([cli.inj.apply(t, update_state=False) for t in targets_cw])
                targets_ccw = np.linspace(360 * INC_PER_DEG, -360 * INC_PER_DEG, 100000)
                actuals_ccw = np.array([cli.inj.apply(t, update_state=False) for t in targets_ccw])
                cli.cal.system_identification(targets_cw, actuals_cw, targets_ccw, actuals_ccw)
                print("[완료] 학습 완료.\n")
                print(f" - a_est = {cli.cal.m_est:.6f}")
                print(f" - b_est = {cli.cal.k_est:.3f} (inc)\n")

            elif cmd == "cal2":
                print("\n[cal2] e6 ratio 추론...")
                pos_0 = cli.inj.apply(cli.inj.prev_cmd, update_state=False)

                cmd_cw = cli.inj.prev_cmd + 10000.0
                pos_1 = cli.inj.apply(cmd_cw, update_state=True)
                cli.cal.e6_cw_ratio_est = ((pos_1 - pos_0) / 10000.0) - 1.0

                pos_2 = cli.inj.apply(cli.inj.prev_cmd, update_state=False)
                cmd_ccw = cli.inj.prev_cmd - 10000.0
                pos_3 = cli.inj.apply(cmd_ccw, update_state=True)
                cli.cal.e6_ccw_ratio_est = ((pos_3 - pos_2) / (-10000.0)) - 1.0

                cli.cal.prev_target = cmd_ccw
                cli.cal.prev_r7_cmd = cmd_ccw

                print(f" - CW ratio est : {cli.cal.e6_cw_ratio_est*100:+.2f}%")
                print(f" - CCW ratio est: {cli.cal.e6_ccw_ratio_est*100:+.2f}%\n")

            elif cmd == "en":
                cli._drain_queue()
                cli.send(CMD_EN)
                time.sleep(0.05)
                cli.send(CMD_SPD_1000)
                print("Sent: en + spd 1000")
                cli.read_status_burst(seconds=1.2)

            elif cmd == "p":
                if cli._log_enabled:
                    cli.stop_logging()
                    print("[INFO] 모니터링 OFF")
                else:
                    cli._drain_queue()
                    cli.start_logging()
                    print("[INFO] 모니터링 ON")

            # --- E toggles ---
            elif cmd == "e1":
                on = cli.inj.toggle_e1()
                print(f"[E1] {'ON' if on else 'OFF'}  a={cli.inj._a_err:.4f}, b={cli.inj._b_err:.1f}")
            elif cmd == "e3":
                print(f"[E3] {'ON' if cli.inj.toggle_e3() else 'OFF'}")
            elif cmd == "e4":
                print(f"[E4] {'ON' if cli.inj.toggle_e4() else 'OFF'}")
            elif cmd == "e5":
                print(f"[E5] {'ON' if cli.inj.toggle_e5() else 'OFF'}")
            elif cmd == "e6":
                print(f"[E6] {'ON' if cli.inj.toggle_e6() else 'OFF'}")

            # --- R toggles ---
            elif cmd == "r1":
                cli.cal.r1_on = not cli.cal.r1_on
                print(f"[R1] {'ON' if cli.cal.r1_on else 'OFF'}")
            elif cmd == "r2":
                cli.cal.r2_on = not cli.cal.r2_on
                print(f"[R2] {'ON' if cli.cal.r2_on else 'OFF'}")
            elif cmd == "r3":
                cli.cal.r3_on = not cli.cal.r3_on
                print(f"[R3] {'ON' if cli.cal.r3_on else 'OFF'}")
            elif cmd == "r4":
                cli.cal.r4_on = not cli.cal.r4_on
                print(f"[R4] {'ON' if cli.cal.r4_on else 'OFF'}")
            elif cmd == "r5":
                cli.cal.r5_on = not cli.cal.r5_on
                print(f"[R5] {'ON' if cli.cal.r5_on else 'OFF'}")
            elif cmd == "r6":
                cli.cal.r6_on = not cli.cal.r6_on
                if cli.cal.r6_on:
                    cli.cal.r7_on = False
                print(f"[R6] {'ON' if cli.cal.r6_on else 'OFF'}")
            elif cmd == "r7":
