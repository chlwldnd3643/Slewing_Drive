import time
import threading
import queue
import random
from typing import Optional, Tuple

import numpy as np
import serial

# =========================================================
# SERIAL PORT SETTINGS
# =========================================================
COM_HANDLE = "COM4"   # 핸들 Arduino (AS5600 -> Sxxx 전송)
COM_SLEW   = "COM3"   # 슬루잉 드라이브 제어 Arduino
BAUD_HANDLE = 57600
BAUD_SLEW   = 115200
READ_TIMEOUT = 0.05

# =========================================================
# DRIVE / KINEMATIC SETTINGS
# =========================================================
CMD_EN = "en"
CMD_SPD_1000 = "spd 1000"

INC_PER_DEG = (182.0 * 70.0 * 150.0) / 62.0
ECC_PERIOD = INC_PER_DEG * (360.0 / 62.0)
MESH_PERIOD = ECC_PERIOD / 150.0

# 핸들 -1000 ~ +1000 을 몇 도로 볼지
MAX_HANDLE_DEG = 90.0

# 제어 주기 제한
SEND_INTERVAL_SEC = 0.03

# True:
#   - 보정 OFF: 오염된 각도를 실제 슬루잉 드라이브 출력각으로 만듦
#   - 보정 ON : 보정된 최종 예상 출력각으로 감
#
# False:
#   - 보정 OFF: 목표각 그대로 전송
#   - 보정 ON : 보정명령(comp_cmd)을 전송
MOVE_TO_PREDICTED = True


# =========================================================
# ERROR INJECTOR
# =========================================================
class InternalErrorInjector:
    """
    E1: 선형 오차 y = a*x + b
    E3: 편심성 사인 오차
    E4: 기어 메쉬 오차
    E5: 백래시
    E6: 누적 슬립
    """
    def __init__(self):
        self.e1_on = False
        self.e3_on = False
        self.e4_on = False
        self.e5_on = False
        self.e6_on = False

        self._a_err = 1.0
        self._b_err = 0.0

        self._ecc_amp = 0.0
        self._mesh_amp = 0.0
        self._backlash = 0.0

        self._e6_cw_ratio = 0.0
        self._e6_ccw_ratio = 0.0
        self._accumulated_e6_err = 0.0

        self.prev_cmd = 0.0
        self.current_dir = 1

    def toggle_e1(self):
        self.e1_on = not self.e1_on
        if self.e1_on:
            rate = random.uniform(0.15, 0.25)
            sign = random.choice([-1.0, 1.0])
            self._a_err = 1.0 + sign * rate
            self._b_err = 0.0
        else:
            self._a_err = 1.0
            self._b_err = 0.0
        return self.e1_on

    def toggle_e3(self):
        self.e3_on = not self.e3_on
        if self.e3_on:
            self._ecc_amp = INC_PER_DEG * random.uniform(0.1, 0.3)
        return self.e3_on

    def toggle_e4(self):
        self.e4_on = not self.e4_on
        if self.e4_on:
            self._mesh_amp = INC_PER_DEG * random.uniform(0.02, 0.05)
        return self.e4_on

    def toggle_e5(self):
        self.e5_on = not self.e5_on
        if self.e5_on:
            self._backlash = INC_PER_DEG * random.uniform(0.2, 0.5)
        return self.e5_on

    def toggle_e6(self):
        self.e6_on = not self.e6_on
        if self.e6_on:
            self._e6_cw_ratio = random.choice([-1.0, 1.0]) * random.uniform(0.20, 0.30)
            self._e6_ccw_ratio = random.choice([-1.0, 1.0]) * random.uniform(0.20, 0.30)
            self._accumulated_e6_err = 0.0
        else:
            self._accumulated_e6_err = 0.0
        return self.e6_on

    def apply(self, cmd_val: float, update_state: bool = True) -> float:
        delta = cmd_val - self.prev_cmd
        direction = 1 if delta >= 0 else -1

        err = 0.0

        if self.e1_on:
            err += (self._a_err * cmd_val + self._b_err) - cmd_val

        if self.e3_on:
            err += self._ecc_amp * np.sin(2.0 * np.pi * cmd_val / ECC_PERIOD)

        if self.e4_on:
            err += self._mesh_amp * np.sin(2.0 * np.pi * cmd_val / MESH_PERIOD)

        if self.e5_on:
            err += (self._backlash / 2.0) if direction >= 0 else -(self._backlash / 2.0)

        e6_step_err = 0.0
        if self.e6_on:
            if delta >= 0:
                e6_step_err = delta * self._e6_cw_ratio
            else:
                e6_step_err = delta * self._e6_ccw_ratio

            if update_state:
                self._accumulated_e6_err += e6_step_err

            err += (self._accumulated_e6_err if update_state else (self._accumulated_e6_err + e6_step_err))

        if update_state:
            self.prev_cmd = cmd_val
            self.current_dir = direction

        return cmd_val + err


# =========================================================
# CALIBRATION FILTER
# =========================================================
class CalibrationFilter:
    def __init__(self):
        self.r1_on = False
        self.r2_on = False
        self.r3_on = False
        self.r4_on = False
        self.r5_on = False
        self.r6_on = False
        self.r7_on = False

        self.k_est = 0.0
        self.m_est = 1.0

        self.ecc_A_est = 0.0
        self.ecc_B_est = 0.0
        self.mesh_A_est = 0.0
        self.mesh_B_est = 0.0
        self.backlash_est = 0.0

        self.e6_cw_ratio_est = 0.0
        self.e6_ccw_ratio_est = 0.0

        self.prev_target = 0.0
        self.prev_r7_cmd = 0.0

    def any_comp_on(self) -> bool:
        return any([self.r1_on, self.r2_on, self.r3_on, self.r4_on, self.r5_on, self.r6_on, self.r7_on])

    def system_identification(self, targets_cw, actuals_cw, targets_ccw, actuals_ccw):
        N = len(targets_cw)
        actuals_ccw_aligned = actuals_ccw[::-1]
        diff = actuals_cw - actuals_ccw_aligned
        self.backlash_est = np.mean(diff)

        actuals_mid = (actuals_cw + actuals_ccw_aligned) / 2.0
        coeffs = np.polyfit(targets_cw, actuals_mid, 1)
        self.m_est = float(coeffs[0])
        self.k_est = float(coeffs[1])

        residuals = actuals_mid - (self.m_est * targets_cw + self.k_est)

        self.ecc_A_est = np.sum(residuals * np.sin(2.0 * np.pi * targets_cw / ECC_PERIOD)) * (2.0 / N)
        self.ecc_B_est = np.sum(residuals * np.cos(2.0 * np.pi * targets_cw / ECC_PERIOD)) * (2.0 / N)

        res_e4 = residuals - (
            self.ecc_A_est * np.sin(2.0 * np.pi * targets_cw / ECC_PERIOD) +
            self.ecc_B_est * np.cos(2.0 * np.pi * targets_cw / ECC_PERIOD)
        )

        self.mesh_A_est = np.sum(res_e4 * np.sin(2.0 * np.pi * targets_cw / MESH_PERIOD)) * (2.0 / N)
        self.mesh_B_est = np.sum(res_e4 * np.cos(2.0 * np.pi * targets_cw / MESH_PERIOD)) * (2.0 / N)

    def pre_compensate(self, target: float) -> float:
        delta_target = target - self.prev_target
        direction = 1 if delta_target >= 0 else -1

        delta_cmd = delta_target

        if self.r7_on:
            if delta_target >= 0:
                delta_cmd = delta_target / (1.0 + self.e6_cw_ratio_est)
            else:
                delta_cmd = delta_target / (1.0 + self.e6_ccw_ratio_est)
            base_cmd = self.prev_r7_cmd + delta_cmd
        elif self.r6_on:
            if delta_target >= 0:
                delta_cmd = delta_target - (delta_target * self.e6_cw_ratio_est)
            else:
                delta_cmd = delta_target - (delta_target * self.e6_ccw_ratio_est)
            base_cmd = self.prev_r7_cmd + delta_cmd
        else:
            base_cmd = target

        cmd = base_cmd

        if self.r5_on:
            cmd -= (self.backlash_est / 2.0) * direction

        if self.r4_on:
            cmd -= (
                self.mesh_A_est * np.sin(2.0 * np.pi * target / MESH_PERIOD) +
                self.mesh_B_est * np.cos(2.0 * np.pi * target / MESH_PERIOD)
            )

        if self.r3_on:
            cmd -= (
                self.ecc_A_est * np.sin(2.0 * np.pi * target / ECC_PERIOD) +
                self.ecc_B_est * np.cos(2.0 * np.pi * target / ECC_PERIOD)
            )

        if self.r1_on:
            cmd -= self.k_est
        if self.r2_on:
            cmd /= self.m_est

        self.prev_target = target
        self.prev_r7_cmd = base_cmd
        return cmd


# =========================================================
# HANDLE SERIAL READER
# =========================================================
class HandleSerialReader:
    """
    핸들 Arduino가 보내는 라인:
      S0
      S-523
      S1000
    """
    def __init__(self, port: str, baud: int, timeout: float = READ_TIMEOUT):
        self.port = port
        self.baud = baud
        self.timeout = timeout

        self.ser = None
        self._rx_thread = None
        self._stop_evt = threading.Event()
        self._latest_cmd = 0
        self._lock = threading.Lock()

    def open(self):
        self.ser = serial.Serial(self.port, self.baud, timeout=self.timeout)
        time.sleep(1.5)
        self._stop_evt.clear()
        self._rx_thread = threading.Thread(target=self._rx_loop, daemon=True)
        self._rx_thread.start()

    def close(self):
        self._stop_evt.set()
        if self._rx_thread:
            self._rx_thread.join(timeout=1.0)
        if self.ser and self.ser.is_open:
            self.ser.close()

    def _rx_loop(self):
        buf = b""
        while not self._stop_evt.is_set():
            try:
                chunk = self.ser.read(128)
            except Exception:
                break
            if not chunk:
                continue

            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                text = line.replace(b"\r", b"").decode("utf-8", errors="ignore").strip()
                if text.startswith("S"):
                    try:
                        v = int(text[1:])
                        v = max(-1000, min(1000, v))
                        with self._lock:
                            self._latest_cmd = v
                    except ValueError:
                        pass

    def get_latest_handle_cmd(self) -> int:
        with self._lock:
            return self._latest_cmd

    def get_latest_handle_deg(self) -> float:
        cmd = self.get_latest_handle_cmd()
        return (cmd / 1000.0) * MAX_HANDLE_DEG

    def get_latest_target_inc(self) -> float:
        deg = self.get_latest_handle_deg()
        return deg * INC_PER_DEG


# =========================================================
# SLEW DRIVE SERIAL CLIENT
# =========================================================
class SlewSerialClient:
    def __init__(self, port: str, baud: int, timeout: float = READ_TIMEOUT):
        self.port = port
        self.baud = baud
        self.timeout = timeout
        self.ser = None

    def open(self):
        self.ser = serial.Serial(self.port, self.baud, timeout=self.timeout)
        time.sleep(1.5)

    def close(self):
        if self.ser and self.ser.is_open:
            self.ser.close()

    def send(self, cmd: str):
        if not self.ser or not self.ser.is_open:
            return
        self.ser.write((cmd.strip() + "\n").encode("utf-8", errors="ignore"))
        self.ser.flush()

    def read_lines(self, seconds: float = 0.3):
        t0 = time.perf_counter()
        while time.perf_counter() - t0 < seconds:
            try:
                line = self.ser.readline().decode("utf-8", errors="ignore").strip()
            except Exception:
                break
            if line:
                print(f"[SLEW] {line}")


# =========================================================
# MAIN CONTROLLER
# =========================================================
class SteeringBridgeSystem:
    def __init__(self):
        self.handle = HandleSerialReader(COM_HANDLE, BAUD_HANDLE, READ_TIMEOUT)
        self.slew = SlewSerialClient(COM_SLEW, BAUD_SLEW, READ_TIMEOUT)

        self.inj = InternalErrorInjector()
        self.cal = CalibrationFilter()

        self.status_unit = "deg"
        self.running = False
        self.ctrl_thread = None
        self.last_send_time = 0.0
        self.last_sent_abs = None

    def open(self):
        self.handle.open()
        self.slew.open()

    def close(self):
        self.stop_rt()
        self.handle.close()
        self.slew.close()

    def enable_drive(self):
        self.slew.send(CMD_EN)
        time.sleep(0.05)
        self.slew.send(CMD_SPD_1000)
        print("[INFO] Sent: en + spd 1000")

    def toggle_rt(self):
        if self.running:
            self.stop_rt()
            print("[INFO] 실시간 추종 OFF")
        else:
            self.start_rt()
            print("[INFO] 실시간 추종 ON")

    def start_rt(self):
        if self.running:
            return
        self.running = True
        self.ctrl_thread = threading.Thread(target=self._control_loop, daemon=True)
        self.ctrl_thread.start()

    def stop_rt(self):
        self.running = False
        if self.ctrl_thread:
            self.ctrl_thread.join(timeout=1.0)
            self.ctrl_thread = None

    def _control_loop(self):
        print(
            f"\n{'HandleDeg':>10} | {'IdealDeg':>10} | {'RawPredDeg':>11} | "
            f"{'CompCmdDeg':>11} | {'CompPredDeg':>12} | {'SentAbsDeg':>11} | {'Mode':>8}"
        )
        print("-" * 92)

        while self.running:
            target_inc = self.handle.get_latest_target_inc()
            handle_deg = self.handle.get_latest_handle_deg()
            target_deg = target_inc / INC_PER_DEG

            raw_pred_inc = self.inj.apply(target_inc, update_state=False)
            comp_cmd_inc = self.cal.pre_compensate(target_inc)
            comp_pred_inc = self.inj.apply(comp_cmd_inc, update_state=False)

            # 보정 OFF:
            #   오염된 각도가 실제 슬루잉 드라이브 각도
            # 보정 ON:
            #   보정 후 예상되는 출력 각도를 실제 슬루잉 드라이브 각도로 사용
            if MOVE_TO_PREDICTED:
                desired_inc = comp_pred_inc if self.cal.any_comp_on() else raw_pred_inc
                send_inc = int(round(desired_inc))
                mode_str = "PRED"
            else:
                send_inc = int(round(comp_cmd_inc)) if self.cal.any_comp_on() else int(round(target_inc))
                mode_str = "CMD"

            now = time.perf_counter()

            # 불필요한 연속 전송 방지
            need_send = False
            if self.last_sent_abs is None:
                need_send = True
            elif abs(send_inc - self.last_sent_abs) >= int(0.2 * INC_PER_DEG):  # 약 0.2도 이상 변할 때만
                need_send = True
            elif (now - self.last_send_time) >= 0.2:
                need_send = True

            if need_send and (now - self.last_send_time) >= SEND_INTERVAL_SEC:
                self.slew.send(f"abs {send_inc}")
                self.last_sent_abs = send_inc
                self.last_send_time = now

                # 상태 업데이트
                _ = self.inj.apply(float(send_inc), update_state=True)

            raw_pred_deg = raw_pred_inc / INC_PER_DEG
            comp_cmd_deg = comp_cmd_inc / INC_PER_DEG
            comp_pred_deg = comp_pred_inc / INC_PER_DEG
            sent_deg = send_inc / INC_PER_DEG

            print(
                f"{handle_deg:10.3f} | {target_deg:10.3f} | {raw_pred_deg:11.3f} | "
                f"{comp_cmd_deg:11.3f} | {comp_pred_deg:12.3f} | {sent_deg:11.3f} | {mode_str:>8}"
            )

            time.sleep(0.05)

    def calibrate_from_model(self):
        print("\n[cal] 오차 모델 기반 학습 시작...")
        targets_cw = np.linspace(-MAX_HANDLE_DEG * INC_PER_DEG, MAX_HANDLE_DEG * INC_PER_DEG, 3000)
        actuals_cw = np.array([self.inj.apply(t, update_state=False) for t in targets_cw])
        targets_ccw = np.linspace(MAX_HANDLE_DEG * INC_PER_DEG, -MAX_HANDLE_DEG * INC_PER_DEG, 3000)
        actuals_ccw = np.array([self.inj.apply(t, update_state=False) for t in targets_ccw])

        self.cal.system_identification(targets_cw, actuals_cw, targets_ccw, actuals_ccw)

        print("[완료] 학습 완료")
        print(f" - a_est = {self.cal.m_est:.6f}")
        print(f" - b_est = {self.cal.k_est:.3f} inc")
        print(f" - backlash_est = {self.cal.backlash_est:.3f} inc")


# =========================================================
# CLI
# =========================================================
def print_help():
    print("\n======= COMMANDS =======")
    print("  en          -> 슬루잉 드라이브 enable + spd 1000")
    print("  rt          -> 핸들 실시간 추종 ON/OFF")
    print("  cal         -> 현재 오차모델 기준 보정 파라미터 학습")
    print("  e1/e3/e4/e5/e6  -> 오염 토글")
    print("  r1~r7       -> 보정 토글")
    print("  q           -> 종료")
    print("========================\n")


def main():
    sysm = SteeringBridgeSystem()

    try:
        sysm.open()
        print("[INFO] 포트 연결 완료")
        print_help()

        while True:
            cmd = input("> ").strip().lower()
            if not cmd:
                continue

            if cmd in ("q", "quit", "exit"):
                break

            elif cmd == "en":
                sysm.enable_drive()

            elif cmd == "rt":
                sysm.toggle_rt()

            elif cmd == "cal":
                sysm.calibrate_from_model()

            # Errors
            elif cmd == "e1":
                on = sysm.inj.toggle_e1()
                print(f"[E1] {'ON' if on else 'OFF'}  a={sysm.inj._a_err:.4f}, b={sysm.inj._b_err:.1f}")
            elif cmd == "e3":
                print(f"[E3] {'ON' if sysm.inj.toggle_e3() else 'OFF'}")
            elif cmd == "e4":
                print(f"[E4] {'ON' if sysm.inj.toggle_e4() else 'OFF'}")
            elif cmd == "e5":
                print(f"[E5] {'ON' if sysm.inj.toggle_e5() else 'OFF'}")
            elif cmd == "e6":
                print(f"[E6] {'ON' if sysm.inj.toggle_e6() else 'OFF'}")

            # Compensation
            elif cmd == "r1":
                sysm.cal.r1_on = not sysm.cal.r1_on
                print(f"[R1] {'ON' if sysm.cal.r1_on else 'OFF'}")
            elif cmd == "r2":
                sysm.cal.r2_on = not sysm.cal.r2_on
                print(f"[R2] {'ON' if sysm.cal.r2_on else 'OFF'}")
            elif cmd == "r3":
                sysm.cal.r3_on = not sysm.cal.r3_on
                print(f"[R3] {'ON' if sysm.cal.r3_on else 'OFF'}")
            elif cmd == "r4":
                sysm.cal.r4_on = not sysm.cal.r4_on
                print(f"[R4] {'ON' if sysm.cal.r4_on else 'OFF'}")
            elif cmd == "r5":
                sysm.cal.r5_on = not sysm.cal.r5_on
                print(f"[R5] {'ON' if sysm.cal.r5_on else 'OFF'}")
            elif cmd == "r6":
                sysm.cal.r6_on = not sysm.cal.r6_on
                if sysm.cal.r6_on:
                    sysm.cal.r7_on = False
                print(f"[R6] {'ON' if sysm.cal.r6_on else 'OFF'}")
            elif cmd == "r7":
                sysm.cal.r7_on = not sysm.cal.r7_on
                if sysm.cal.r7_on:
                    sysm.cal.r6_on = False
                print(f"[R7] {'ON' if sysm.cal.r7_on else 'OFF'}")

            else:
                print("Unknown command")
                print_help()

    finally:
        sysm.close()
        print("시스템 종료.")


if __name__ == "__main__":
    main()
