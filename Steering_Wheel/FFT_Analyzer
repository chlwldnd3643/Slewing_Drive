                # ==========================================
                actual_max = np.max(x_raw)
                actual_min = np.min(x_raw)
                
                # SDO 명령 기준 오차 자동 계산
                # 실제 출력 범위가 [-a+b, a+c] 라고 가정할 때:
                c_err = actual_max - PARAM_A        # 상한 오차 (c)
                b_err = actual_min - (-PARAM_A)     # 하한 오차 (b)
                
                max_deviation = max(abs(c_err), abs(b_err))
                
                # 오차가 허용치(TOLERANCE)보다 클 때만 보정 적용
                if max_deviation > ERROR_TOLERANCE:
                    print(f"⚠️ SDO 지령 이탈 감지! (최대 오차: {max_deviation:.2f} > {ERROR_TOLERANCE})")
                    print(f"   -> 하한 오차(b): {b_err:.2f}, 상한 오차(c): {c_err:.2f}")
                    
                    # 오프셋(k) 및 게인(m) 계산
                    k = (b_err + c_err) / 2.0
                    m = (2.0 * PARAM_A + c_err - b_err) / (2.0 * PARAM_A)
                    
                    if m != 0:
                        x = (x_raw - k) / m
