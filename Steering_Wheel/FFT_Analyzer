import time
import threading
import queue
from dataclasses import dataclass
from typing import List, Optional, Tuple

import numpy as np
import serial
import matplotlib.pyplot as plt


# ==========================
# FIXED SETTINGS
# ==========================
PORT = "COM3"
UNO_BAUD = 115200
READ_TIMEOUT = 0.2

CMD_EN = "en"
CMD_SPD_1000 = "spd 1000"


# ==========================
# DATA
# ==========================
@dataclass
class StreamDump:
    fs_hz: float
    t_s: np.ndarray
    pos: np.ndarray


# ==========================
# PC-SIDE FILTER
# ==========================
@dataclass
class FilterConfig:
    deadband: float = 0.0
    fc_low_hz: float = 0.8
    fc_high_hz: float = 6.0
    v1: float = 10.0
    v2: float = 250.0
    max_rate: float = 0.0

    # dt floor to stabilize PC-time jitter
    dt_floor_s: float = 0.005  # 5ms


class AdaptiveSmoother:
    def __init__(self, cfg: FilterConfig):
        self.cfg = cfg
        self._inited = False
        self._t_prev: Optional[float] = None
        self._x_prev: float = 0.0
        self._y: float = 0.0

        # debug signals
        self.last_alpha: float = 0.0
        self.last_fc_hz: float = 0.0
        self.last_v: float = 0.0
        self.last_w: float = 0.0
        self.last_dt: float = 0.0

    @staticmethod
    def _alpha_from_fc(fc_hz: float, dt: float) -> float:
        if fc_hz <= 0 or dt <= 0:
            return 1.0
        return float(1.0 - np.exp(-2.0 * np.pi * fc_hz * dt))

    @staticmethod
    def _clamp(x: float, lo: float, hi: float) -> float:
        return max(lo, min(hi, x))

    def reset(self):
        self._inited = False
        self._t_prev = None
        self._x_prev = 0.0
        self._y = 0.0
        self.last_alpha = 0.0
        self.last_fc_hz = 0.0
        self.last_v = 0.0
        self.last_w = 0.0
        self.last_dt = 0.0

    def update(self, t_s: float, x: float) -> float:
        if not self._inited:
            self._inited = True
            self._t_prev = t_s
            self._x_prev = x
            self._y = x
            self.last_alpha = 1.0
            self.last_fc_hz = 0.0
            self.last_v = 0.0
            self.last_w = 0.0
            self.last_dt = 0.0
            return self._y

        dt = float(t_s - (self._t_prev if self._t_prev is not None else t_s))
        if dt <= 0:
            dt = 1e-3

        # stabilize dt so jitter doesn't make filter behave like identity
        if self.cfg.dt_floor_s and dt < self.cfg.dt_floor_s:
            dt = self.cfg.dt_floor_s

        dx = float(x - self._x_prev)
        v = abs(dx) / dt

        # deadband
        x_eff = self._x_prev if (self.cfg.deadband > 0 and abs(dx) < self.cfg.deadband) else x
        if x_eff == self._x_prev:
            v = 0.0

        if self.cfg.v2 <= self.cfg.v1:
            w = 1.0
        else:
            w = (v - self.cfg.v1) / (self.cfg.v2 - self.cfg.v1)
        w = self._clamp(w, 0.0, 1.0)

        fc = (1.0 - w) * self.cfg.fc_low_hz + w * self.cfg.fc_high_hz
        a = self._alpha_from_fc(fc, dt)

        y = self._y + a * (x_eff - self._y)

        if self.cfg.max_rate and self.cfg.max_rate > 0:
            max_step = self.cfg.max_rate * dt
            y = self._clamp(y, self._y - max_step, self._y + max_step)

        # store debug
        self.last_alpha = a
        self.last_fc_hz = fc
        self.last_v = v
        self.last_w = w
        self.last_dt = dt

        self._t_prev = t_s
        self._x_prev = x_eff
        self._y = y
        return y


# ==========================
# SERIAL CLIENT
# ==========================
class ArduinoClient:
    def __init__(self, port: str, baud: int = UNO_BAUD, timeout: float = READ_TIMEOUT):
        self.port = port
        self.baud = baud
        self.timeout = timeout
        self.ser: Optional[serial.Serial] = None

        self._rx_thread: Optional[threading.Thread] = None
        self._stop_evt = threading.Event()

        self._lines = queue.Queue(maxsize=8000)

        self._log_thread: Optional[threading.Thread] = None
        self._log_stop_evt = threading.Event()
        self._log_enabled = False

    def open(self):
        self.ser = serial.Serial(self.port, self.baud, timeout=self.timeout)
        time.sleep(1.5)  # UNO reset on open
        self._stop_evt.clear()
        self._rx_thread = threading.Thread(target=self._rx_loop, daemon=True)
        self._rx_thread.start()

    def close(self):
        self.shutdown_logging()
        self._stop_evt.set()
        if self._rx_thread:
            self._rx_thread.join(timeout=1.0)
        if self.ser and self.ser.is_open:
            self.ser.close()
        self.ser = None

    def send(self, cmd: str):
        if not self.ser or not self.ser.is_open:
            raise RuntimeError("Serial not open")
        self.ser.write((cmd.strip() + "\n").encode("utf-8", errors="ignore"))
        self.ser.flush()

    def _rx_loop(self):
        assert self.ser is not None
        buf = b""
        while not self._stop_evt.is_set():
            try:
                chunk = self.ser.read(512)
            except Exception:
                break
            if not chunk:
                continue
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.replace(b"\r", b"")
                text = line.decode("utf-8", errors="replace")

                try:
                    self._lines.put_nowait(text)
                except queue.Full:
                    try:
                        _ = self._lines.get_nowait()
                        self._lines.put_nowait(text)
                    except Exception:
                        pass

    def read_line(self, timeout_s: float = 0.5) -> Optional[str]:
        try:
            return self._lines.get(timeout=timeout_s)
        except queue.Empty:
            return None

    def _drain_queue(self):
        try:
            while True:
                self._lines.get_nowait()
        except queue.Empty:
            pass

    def start_logging(self):
        self._log_enabled = True
        if self._log_thread and self._log_thread.is_alive():
            return
        self._log_stop_evt.clear()

        def _printer():
            while not self._log_stop_evt.is_set():
                if not self._log_enabled:
                    time.sleep(0.05)
                    continue
                line = self.read_line(timeout_s=0.2)
                if line:
                    print(line.strip())

        self._log_thread = threading.Thread(target=_printer, daemon=True)
        self._log_thread.start()

    def stop_logging(self):
        self._log_enabled = False

    def shutdown_logging(self):
        self._log_stop_evt.set()
        if self._log_thread:
            self._log_thread.join(timeout=1.0)
            self._log_thread = None
        self._log_enabled = False

    def peek(self, seconds: float = 2.0):
        self._drain_queue()
        print(f"\n--- PEEK {seconds:.1f}s ---")
        t0 = time.perf_counter()
        while time.perf_counter() - t0 < seconds:
            line = self.read_line(timeout_s=0.2)
            if line:
                print(line.strip())
        print("--- END ---\n")

    def read_status_burst(self, seconds: float = 1.0):
        t0 = time.perf_counter()
        while time.perf_counter() - t0 < seconds:
            line = self.read_line(timeout_s=0.05)
            if not line:
                continue
            s = line.strip()
            if self.parse_value(s) is not None:
                continue
            print(s)

    @staticmethod
    def parse_value(line: str) -> Optional[int]:
        """
        Accept either:
          - S123 / S-456
          - [CTRL] 607A=220500  [FILT]=OFF  (extract 220500)
        """
        s = line.strip()

        # 1) S protocol
        if len(s) >= 2 and s[0] == "S":
            tail = s[1:].strip()
            try:
                return int(tail)
            except Exception:
                pass

        # 2) CTRL 607A format
        key = "607A="
        idx = s.find(key)
        if idx >= 0:
            j = idx + len(key)
            k = j
            if k < len(s) and s[k] == "-":
                k += 1
            while k < len(s) and s[k].isdigit():
                k += 1
            num = s[j:k].strip()
            if num:
                try:
                    return int(num)
                except Exception:
                    pass

        return None

    def capture_stream_pc_time(self, seconds: float = 10.0, overall_timeout_s: float = 15.0) -> StreamDump:
        self._drain_queue()

        t_list: List[float] = []
        pos_list: List[float] = []

        t_start = time.perf_counter()
        deadline = t_start + overall_timeout_s
        stop_at = t_start + seconds

        while True:
            now = time.perf_counter()
            if now >= stop_at or now >= deadline:
                break

            line = self.read_line(timeout_s=0.5)
            if not line:
                continue

            val = self.parse_value(line)
            if val is None:
                continue

            t_list.append(now - t_start)
            pos_list.append(float(val))

        if len(pos_list) < 16:
            raise ValueError("Too few samples parsed (need >=16). Device isn't sending parsable numeric stream.")

        t_arr = np.array(t_list, dtype=float)
        p_arr = np.array(pos_list, dtype=float)
        dt = np.median(np.diff(t_arr)) if len(t_arr) >= 3 else 0.0
        fs = (1.0 / dt) if dt > 0 else 0.0
        return StreamDump(fs_hz=float(fs), t_s=t_arr, pos=p_arr)


# ==========================
# FFT
# ==========================
class FftAnalyzer:
    @staticmethod
    def compute_fft(pos: np.ndarray, fs_hz: float) -> Tuple[np.ndarray, np.ndarray]:
        x = np.asarray(pos, dtype=float)
        x = x - np.mean(x)
        w = np.hanning(len(x))
        xw = x * w
        X = np.fft.rfft(xw)
        freqs = np.fft.rfftfreq(len(xw), d=1.0 / fs_hz)
        mag = np.abs(X) / (len(xw) / 2.0)
        return freqs, mag

    @staticmethod
    def plot_compare(t_s, raw, filt, fs_hz, title):
        plt.close("all")

        fr, mr = FftAnalyzer.compute_fft(raw, fs_hz)
        ff, mf = FftAnalyzer.compute_fft(filt, fs_hz)

        # ---- TIME: raw + filtered (make RAW on top, thick dashed)
        fig1 = plt.figure()
        ax1 = fig1.add_subplot(111)

        # filtered first (so it's underneath)
        ax1.plot(t_s, filt, "-", label="filtered(PC)", linewidth=2, zorder=2)

        # raw on top, thick dashed
        ax1.plot(t_s, raw, "--", label="raw (dashed)", linewidth=3, zorder=5)

        ax1.grid(True)
        ax1.legend()
        ax1.set_title(f"{title} - Time")

        # ---- TIME DIFFERENCE
        figd = plt.figure()
        axd = figd.add_subplot(111)
        axd.plot(t_s, raw - filt, "-", label="raw - filtered", linewidth=1.5)
        axd.grid(True)
        axd.legend()
        axd.set_title(f"{title} - Difference (raw - filtered)")

        # ---- FFT: raw on top, thick dashed (semilogy)
        fig2 = plt.figure()
        ax2 = fig2.add_subplot(111)

        # filtered under
        ax2.semilogy(ff, mf + 1e-12, "-", label="filtered(PC)", linewidth=2, zorder=2)

        # raw on top, thick dashed
        ax2.semilogy(fr, mr + 1e-12, "--", label="raw (dashed)", linewidth=3, zorder=5)

        ax2.grid(True, which="both")
        ax2.legend()
        ax2.set_title(f"{title} - FFT (Fs={fs_hz:.2f}Hz, N={len(raw)})")

        # ---- FFT dB ratio: 20log10(filtered/raw)
        eps = 1e-12
        db = 20.0 * np.log10((mf + eps) / (mr + eps))
        fig3 = plt.figure()
        ax3 = fig3.add_subplot(111)
        ax3.plot(ff, db, "-", linewidth=1.5)
        ax3.grid(True)
        ax3.set_title(f"{title} - FFT Difference: 20log10(filtered/raw) [dB]")
        ax3.set_xlabel("Hz")
        ax3.set_ylabel("dB")

        plt.show(block=True)


# ==========================
# CLI
# ==========================
def interactive_main():
    print(f"Using fixed port: {PORT}")
    cli = ArduinoClient(port=PORT, baud=UNO_BAUD, timeout=READ_TIMEOUT)
    cli.open()

    fcfg = FilterConfig()
    smoother = AdaptiveSmoother(fcfg)

    def rms(x: np.ndarray) -> float:
        x = np.asarray(x, dtype=float)
        return float(np.sqrt(np.mean(x * x))) if len(x) else 0.0

    print("\nCommands:")
    print("  en            -> send 'en' then 'spd 1000' and show status")
    print("  1 / 2 / 3     -> send mode and show status")
    print("  peek [sec]    -> show raw incoming lines")
    print("  log / stop    -> start/stop printing everything")
    print("  cap [sec]     -> capture numeric stream (S### or 607A=###)")
    print("  cmpfft [sec]  -> capture + PC filter + FFT plots + RMS improvement")
    print("  q             -> quit\n")

    try:
        while True:
            cmd = input("> ").strip()
            if not cmd:
                continue

            if cmd in ("q", "quit", "exit"):
                break

            if cmd.startswith("peek"):
                parts = cmd.split()
                sec = float(parts[1]) if len(parts) >= 2 else 2.0
                cli.peek(seconds=sec)
                continue

            if cmd == "log":
                cli.start_logging()
                print("Logging started. Type 'stop' to stop.")
                continue

            if cmd == "stop":
                cli.stop_logging()
                print("Logging stopped.")
                continue

            if cmd in ("1", "2", "3"):
                cli._drain_queue()
                cli.send(cmd)
                print(f"Sent mode {cmd}. Status:")
                cli.read_status_burst(seconds=1.2)
                continue

            if cmd == "en":
                cli._drain_queue()
                cli.send(CMD_EN)
                time.sleep(0.05)
                cli.send(CMD_SPD_1000)
                print("Sent: en + spd 1000. Status:")
                cli.read_status_burst(seconds=1.2)
                continue

            if cmd.startswith("cap"):
                parts = cmd.split()
                sec = float(parts[1]) if len(parts) >= 2 else 5.0
                cli.stop_logging()
                print(f"Capturing {sec:.1f}s...")
                try:
                    sd = cli.capture_stream_pc_time(seconds=sec, overall_timeout_s=sec + 5.0)
                    print(f"OK: N={len(sd.pos)}, Fs~{sd.fs_hz:.2f} Hz")
                    print(f"Sample range: {sd.pos.min():.0f} .. {sd.pos.max():.0f}")
                except Exception as e:
                    print(f"ERROR: {e}")
                    print("What UNO is actually sending:")
                    cli.peek(seconds=2.0)
                continue

            if cmd.startswith("cmpfft"):
                parts = cmd.split()
                sec = float(parts[1]) if len(parts) >= 2 else 10.0
                cli.stop_logging()
                print(f"FFT: capturing {sec:.1f}s stream...")
                try:
                    sd = cli.capture_stream_pc_time(seconds=sec, overall_timeout_s=sec + 5.0)
                except Exception as e:
                    print(f"ERROR: {e}")
                    print("What UNO is actually sending:")
                    cli.peek(seconds=2.0)
                    continue

                print("FFT: applying PC filter...")
                smoother.reset()
                filt = np.zeros_like(sd.pos, dtype=float)

                alphas, fcs, vs, dts = [], [], [], []

                for i in range(len(sd.pos)):
                    filt[i] = smoother.update(float(sd.t_s[i]), float(sd.pos[i]))
                    alphas.append(smoother.last_alpha)
                    fcs.append(smoother.last_fc_hz)
                    vs.append(smoother.last_v)
                    dts.append(smoother.last_dt)

                alphas = np.asarray(alphas)
                fcs = np.asarray(fcs)
                vs = np.asarray(vs)
                dts = np.asarray(dts)

                print(
                    f"[Filter Stats] alpha(min/med/max)={alphas.min():.4f}/{np.median(alphas):.4f}/{alphas.max():.4f} | "
                    f"fc(min/med/max)={fcs.min():.3f}/{np.median(fcs):.3f}/{fcs.max():.3f} Hz | "
                    f"dt(min/med/max)={dts.min():.4f}/{np.median(dts):.4f}/{dts.max():.4f} s | "
                    f"v(med/max)={np.median(vs):.3f}/{vs.max():.3f}"
                )

                # ===== RMS / Improvement metrics =====
                raw0 = sd.pos - np.mean(sd.pos)
                filt0 = filt - np.mean(filt)

                raw_rms = rms(raw0)
                filt_rms = rms(filt0)
                resid_rms = rms(sd.pos - filt)  # how much filter changed the signal

                d_raw = np.diff(sd.pos)
                d_filt = np.diff(filt)
                d1_raw_rms = rms(d_raw)
                d1_filt_rms = rms(d_filt)

                rough_reduction_pct = 0.0
                if d1_raw_rms > 0:
                    rough_reduction_pct = 100.0 * (1.0 - (d1_filt_rms / d1_raw_rms))

                resid_to_signal_pct = 0.0
                if raw_rms > 0:
                    resid_to_signal_pct = 100.0 * (resid_rms / raw_rms)

                print(
                    f"[RMS] raw_rms={raw_rms:.3f} | filt_rms={filt_rms:.3f} | "
                    f"resid_rms(raw-filt)={resid_rms:.3f}  (resid/raw={resid_to_signal_pct:.2f}%)"
                )
                print(
                    f"[Roughness RMS] rms(diff(raw))={d1_raw_rms:.3f} -> rms(diff(filt))={d1_filt_rms:.3f} | "
                    f"reduction={rough_reduction_pct:.2f}%"
                )

                # optional: “are they basically identical?”
                max_abs_diff = float(np.max(np.abs(sd.pos - filt)))
                print(f"[Overlap Check] max|raw-filtered| = {max_abs_diff:.3f}")

                FftAnalyzer.plot_compare(sd.t_s, sd.pos, filt, sd.fs_hz, title=f"cmpfft ({sec:.0f}s)")
                continue

            # passthrough
            cli.send(cmd)
            print("Sent. Status:")
            cli.read_status_burst(seconds=0.6)

    finally:
        cli.stop_logging()
        cli.close()
        print("Closed.")


if __name__ == "__main__":
    interactive_main()
